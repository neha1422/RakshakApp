# Public Firebase web config (not admin credentials)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=rakshakapp-cloud.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rakshakapp-cloud
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend only. Configure in Vercel; NEVER prefix these with VITE_.
FIREBASE_PROJECT_ID=rakshakapp-cloud
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
